{
  "env": {
    "GRAPHIFY_NO_AUTO_REFRESH": "1",
    "AZURE_MCP_COLLECT_TELEMETRY": "false"
  },
  "permissions": {
    "deny": [
      "Bash(git push --force*)"
    ],
    "ask": [
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(git reset --hard *)",
      "Bash(git branch -D *)",
      "Bash(maestri floor land *)",
      "Bash(maestri floor delete *)",
      "Bash(rm *)"
    ]
  },
  "model": "opus",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "context7@context7-marketplace": true,
    "ponytail@ponytail": true,
    "caveman@caveman": true,
    "skill-creator@claude-plugins-official": true,
    "mattpocock-skills@mattpocock": true,
    "typescript-lsp@claude-plugins-official": true,
    "csharp-lsp@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "dotnet@dotnet-agent-skills": false,
    "dotnet-test@dotnet-agent-skills": false,
    "dotnet-aspnetcore@dotnet-agent-skills": false,
    "dotnet-diag@dotnet-agent-skills": false,
    "dotnet-data@dotnet-agent-skills": false,
    "dotnet-upgrade@dotnet-agent-skills": false,
    "azure@azure-skills": false,
    "google-cloud-developer@google-plugins": false,
    "n8n-mcp-skills@n8n-mcp-skills": false,
    "code-review@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    },
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    },
    "context7-marketplace": {
