prefix_rule(pattern=["maestri"], decision="allow")
prefix_rule(pattern=["git", "fetch"], decision="allow")
prefix_rule(pattern=["npm", "run", "agent:setup"], decision="allow")
prefix_rule(pattern=["gh", "release"], decision="allow")
prefix_rule(pattern=["git", "worktree", "add"], decision="allow")
prefix_rule(pattern=["gh", "run"], decision="allow")
prefix_rule(pattern=["/bin/zsh", "-lc", "npm run agent:finish > /private/tmp/orbit-efficiency-agent-finish.log 2>&1"], decision="allow")
prefix_rule(pattern=["git", "commit"], decision="forbidden", justification="Git write commands are reserved to the Maestro after user approval.")
prefix_rule(pattern=["git", "push"], decision="forbidden", justification="Git write commands are reserved to the Maestro after user approval.")
prefix_rule(pattern=["git", "merge"], decision="forbidden", justification="Git write commands are reserved to the Maestro after user approval.")
prefix_rule(pattern=["git", "rebase"], decision="forbidden", justification="Git write commands are reserved to the Maestro after user approval.")
prefix_rule(pattern=["git", "reset"], decision="forbidden", justification="Git write commands are reserved to the Maestro after user approval.")
prefix_rule(pattern=["git", "branch", "-D"], decision="forbidden", justification="Git write commands are reserved to the Maestro after user approval.")
